{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RankHouse Developers",
  "description": "Connect any website to RankHouse with the publishing API: a few HTTPS endpoints on your site, signed requests from ours.",
  "colors": {
    "primary": "#8a6248",
    "light": "#D4AE72",
    "dark": "#221B15"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/introduction"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["introduction", "quickstart", "authentication", "capabilities"]
      },
      {
        "group": "Endpoints you build",
        "pages": [
          "endpoints/handshake",
          "endpoints/create-post",
          "endpoints/update-post",
          "endpoints/seo",
          "endpoints/pages",
          "endpoints/categories-and-authors"
        ]
      },
      {
        "group": "Sample receivers",
        "pages": ["samples/node", "samples/python", "samples/php"]
      },
      {
        "group": "Help",
        "pages": ["troubleshooting"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@rankhouse.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open RankHouse",
      "href": "https://rankhouse.ai"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"]
  }
}
